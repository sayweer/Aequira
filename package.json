{
  "name": "aequira",
  "version": "0.0.0",
  "private": true,
  "description": "Privacy-preserving scholarship and grant decisions on Midnight Network",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.11.1",
    "pnpm": ">=11.9.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "compact:build": "pnpm --filter @aequira/contract run compact:build",
    "compact:check": "pnpm --filter @aequira/contract run compact:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "verify": "pnpm format:check && pnpm compact:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "25.3.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  }
}
