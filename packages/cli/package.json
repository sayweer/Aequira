{
  "name": "@aequira/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "aequira": "./dist/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "doctor": "pnpm run build && node dist/main.js doctor",
    "start": "pnpm run build && node dist/main.js",
    "test": "pnpm run build && node --test",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  }
}
